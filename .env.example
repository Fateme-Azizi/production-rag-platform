# =============================================================================
# FastAPI Baseline - Environment Configuration
# =============================================================================
# Copy this file to .env and modify as needed:
#   cp env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Application / Environment
# -----------------------------------------------------------------------------
APP_NAME=fastapi-baseline
APP_DESCRIPTION=FastAPI Baseline Application
APP_VERSION=0.0.1
# Environment: dev, staging, production
ENV=dev
# Set to true if behind a reverse proxy (nginx, traefik, etc.)
BEHIND_PROXY=false

# -----------------------------------------------------------------------------
# HTTP Server (Uvicorn)
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Number of worker processes (set to CPU cores in production)
WORKERS=1
TIMEOUT_KEEP_ALIVE=30
# Uncomment to limit concurrent connections
# LIMIT_CONCURRENCY=100
# Uncomment to limit max requests before worker restart
# LIMIT_MAX_REQUESTS=10000
FORWARDED_ALLOW_IPS=*
# Auto-reload on code changes (disable in production)
RELOAD=true

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Enable JSON logging to console (stdout)
ENABLE_CONSOLE_LOGGING=true
# Enable syslog logging (for centralized logging)
ENABLE_SYSLOG_LOGGING=false
# Enable request logging to file
ENABLE_REQUEST_LOGGING=false
# Directory for log files
BASE_DIR=logs
# Number of days to retain log files
RETENTION_COUNT=7
# Syslog server configuration (if ENABLE_SYSLOG_LOGGING=true)
# SYSLOG_HOST=localhost
SYSLOG_PORT=514
# Traceback depth limit
TRACEBACK_LIMIT=1

# -----------------------------------------------------------------------------
# HTTP Client (aiohttp) - For outgoing API calls
# -----------------------------------------------------------------------------
HTTP_USER_AGENT=FastAPI-Baseline/1.0
# Connection pool settings
HTTP_MAX_CONNECTIONS=100
HTTP_TOTAL_TIMEOUT=10.0
HTTP_CONNECT_TIMEOUT=3.0
HTTP_READ_TIMEOUT=7.0
HTTP_KEEPALIVE_TIMEOUT=30.0
# Retry settings
HTTP_RETRY_ATTEMPTS=3
HTTP_RETRY_MIN_WAIT=0.25
HTTP_RETRY_MAX_WAIT=2.0
# Status codes that trigger retry (JSON array or comma-separated)
HTTP_RETRY_STATUS_CODES=[429, 500, 502, 503, 504]
# Debug settings (NEVER enable in production!)
DEBUG_HTTP_BODIES=false
# Keys to redact in logs (JSON array or comma-separated)
HTTP_LOG_REDACT_KEYS=["password", "secret", "token", "authorization", "api_key"]

# -----------------------------------------------------------------------------
# Database (PostgreSQL) - Optional
# -----------------------------------------------------------------------------
# Option 1: Use a full connection URI
DATABASE_USE_URI=false
# DATABASE_URI=postgresql+asyncpg://user:password@localhost:5432/dbname

# Option 2: Use individual connection parameters
# DATABASE_SERVER=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=fastapi_baseline
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=your_password_here

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_URI=amqp://username:password@localhost:5672/
RABBITMQ_DEAD_LETTER=dead
# -----------------------------------------------------------------------------
# OpenTelemetry / Distributed Tracing
# -----------------------------------------------------------------------------
# Enable/disable tracing
OTEL_ENABLED=false
# Service name for traces (defaults to APP_NAME if not set)
# OTEL_SERVICE_NAME=my-service

# Exporter type: console, otlp, none
# - console: prints traces to stdout (for development)
# - otlp: sends traces to an OpenTelemetry collector (for production)
# - none: disables trace export
OTEL_EXPORTER=console

# OTLP collector endpoints (if OTEL_EXPORTER=otlp)
# gRPC endpoint (default)
OTEL_OTLP_ENDPOINT=http://localhost:4317
# HTTP endpoint (alternative, uncomment to use HTTP instead of gRPC)
# OTEL_OTLP_HTTP_ENDPOINT=http://localhost:4318/v1/traces

# Sampling rate: 0.0 to 1.0 (1.0 = 100% of traces)
# Use lower values in production to reduce overhead
OTEL_SAMPLE_RATE=1.0

# Trace context propagators (comma-separated)
# Options: tracecontext, baggage, b3, b3multi
OTEL_PROPAGATORS=tracecontext,baggage

# Auto-instrumentation toggles
OTEL_INSTRUMENT_FASTAPI=true
OTEL_INSTRUMENT_AIOHTTP=true
OTEL_INSTRUMENT_FASTSTREAM=true
OTEL_INSTRUMENT_LOGGING=true

# =============================================================================
# Production Recommendations
# =============================================================================
# For production deployments, consider these settings:
#
# ENV=production
# RELOAD=false
# WORKERS=4  # or number of CPU cores
# LOG_LEVEL=WARNING
# DEBUG_HTTP_BODIES=false
# OTEL_ENABLED=true
# OTEL_EXPORTER=otlp
# OTEL_SAMPLE_RATE=0.1  # 10% sampling to reduce overhead
# =============================================================================

